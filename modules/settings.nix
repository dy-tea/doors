self:
{
  config,
  lib,
  options,
  pkgs,
  ...
}:

let
  inherit (lib)
    attrByPath
    concatLists
    concatMapStringsSep
    concatStringsSep
    escapeShellArg
    hasInfix
    listToAttrs
    literalExpression
    mapAttrsToList
    mkIf
    mkOption
    nameValuePair
    optional
    types
    unique
    ;

  cfg = config.programs.doors;

  upstream = import ./upstream-settings.nix { inherit lib; };

  header = "# Generated by the doors Nix modules. Edit programs.doors.settings, not this file.";

  # --- option tree -------------------------------------------------------

  mkLeaf =
    entry:
    mkOption {
      type = types.nullOr entry.type;
      default = null;
      example = entry.example;
      description = entry.description;
    };

  legacyFlag = mkOption {
    type = types.listOf types.str;
    default = [ ];
    internal = true;
    description = "Deprecation messages collected by the legacy option shims.";
  };

  mkOptionTree =
    entries: importsFor:
    let
      names = unique (map (e: builtins.head e.path) entries);
      mkOne =
        name:
        let
          matching = builtins.filter (e: builtins.head e.path == name) entries;
          rest = map (e: e // { path = builtins.tail e.path; }) matching;
          isLeaf = builtins.length matching == 1 && (builtins.head matching).path == [ name ];
        in
        if isLeaf then
          mkLeaf (builtins.head matching)
        else if builtins.any (e: e.path == [ name ]) matching then
          throw "doors: option path is both a group and a leaf: ${name}"
        else
          mkOption {
            type = types.submodule {
              imports = importsFor.${name} or [ ];
              options = mkOptionTree rest importsFor // {
                _legacy = legacyFlag;
              };
            };
            default = { };
            description = "Doors `${name}` settings.";
          };
    in
    if entries == [ ] then
      throw "doors: empty option group"
    else
      listToAttrs (map (n: nameValuePair n (mkOne n)) names);

  # --- doorsrc generation ------------------------------------------------

  boolString = b: if b then "1" else "0";

  envLines = mapAttrsToList (n: v: "doorsctl env set ${escapeShellArg n} ${escapeShellArg v}") cfg.settings.env;

  outputLines = mapAttrsToList (
    name: _:
    "doorsctl output ${escapeShellArg name} -d ${
      concatMapStringsSep " " escapeShellArg cfg.settings.desktop.workspaces
    }"
  ) cfg.settings.outputs;

  outputSettingsLines = concatLists (
    mapAttrsToList (
      name: oc:
      optional (oc.enable != null) "doorsctl output ${escapeShellArg name} ${if oc.enable then "enable" else "disable"}"
      ++ optional (oc.mode != null) "doorsctl output ${escapeShellArg name} mode ${oc.mode}"
      ++ optional (oc.position != null)
        "doorsctl output ${escapeShellArg name} position ${toString oc.position.x} ${toString oc.position.y}"
      ++ optional (oc.scale != null) "doorsctl output ${escapeShellArg name} scale ${toString oc.scale}"
      ++ optional (oc.transform != null) "doorsctl output ${escapeShellArg name} transform ${oc.transform}"
      ++ optional (oc.dpms != null) "doorsctl output ${escapeShellArg name} dpms ${oc.dpms}"
      ++ optional (oc.adaptive-sync != null)
        "doorsctl output ${escapeShellArg name} adaptive_sync ${oc.adaptive-sync}"
      ++ optional (oc.render-bit-depth != null)
        "doorsctl output ${escapeShellArg name} render_bit_depth ${oc.render-bit-depth}"
      ++ optional (oc.color-profile != null)
        "doorsctl output ${escapeShellArg name} color_profile ${oc.color-profile}"
      ++ optional (oc.color-profile-icc != null)
        "doorsctl output ${escapeShellArg name} color_profile icc ${toString oc.color-profile-icc}"
      ++ optional (oc.hdr != null) "doorsctl output ${escapeShellArg name} hdr ${oc.hdr}"
      ++ optional (oc.tearing != null) "doorsctl output ${escapeShellArg name} tearing ${oc.tearing}"
      ++ optional (oc.max-render-time != null)
        "doorsctl output ${escapeShellArg name} max_render_time ${toString oc.max-render-time}"
    ) cfg.settings.outputs
  );

  desktopLines = optional (cfg.settings.desktop.defaultLayout != null)
    "doorsctl desktop --layout ${cfg.settings.desktop.defaultLayout} --all";

  configLines = builtins.concatMap (
    entry:
    let
      value = attrByPath entry.path null cfg.settings.config;
    in
    optional (value != null) ("doorsctl " + concatMapStringsSep " " escapeShellArg (entry.argv value))
  ) upstream.entries;

  # --- animation curve registration --------------------------------------

  builtinBeziers = [
    "default"
    "linear"
    "ease"
    "ease_in"
    "ease_out"
    "ease_in_out"
  ];

  builtinSprings = [
    "default"
    "bouncy"
    "gentle"
    "slow"
  ];

  curveRefs =
    let
      animations = cfg.settings.config.animations;
      globalBezier = optional (animations.bezier != null) {
        kind = "bezier";
        name = animations.bezier;
      };
      perType = builtins.concatMap (
        t:
        let
          typeCfg = animations.types.${t} or { };
        in
        optional ((typeCfg.bezier or null) != null) {
          kind = "bezier";
          name = typeCfg.bezier;
        }
        ++ optional ((typeCfg.spring or null) != null) {
          kind = "spring";
          name = typeCfg.spring;
        }
      ) upstream.animationTypes;
    in
    builtins.filter (c: c.name != "") (globalBezier ++ perType);

  builtinCurve = c: builtins.elem c.name (if c.kind == "bezier" then builtinBeziers else builtinSprings);

  unregisteredCurves = builtins.filter (
    c: !(builtinCurve c) && !(hasInfix "${c.kind} ${c.name}" cfg.settings.extraConfig)
  ) curveRefs;

  # --- renamed option paths ----------------------------------------------

  legacyRename =
    prefix: from: to:
    {
      config,
      options,
      lib,
      ...
    }:
    let
      fromOpt = lib.getAttrFromPath from options;
    in
    {
      options = lib.setAttrByPath from (mkOption {
        type = types.unspecified;
        visible = false;
        description = "Deprecated alias of `${lib.showOption (prefix ++ to)}`.";
      });
      config = mkIf fromOpt.isDefined (
        {
          _legacy = [
            "The option `programs.doors.settings.config.${lib.showOption (prefix ++ from)}` has been renamed to `programs.doors.settings.config.${lib.showOption (prefix ++ to)}`."
          ];
        }
        // lib.setAttrByPath to (lib.mkDefault (lib.getAttrFromPath from config))
      );
    };

  # `windows.<state>-border` used the old primary/secondary/lerp shape rather
  # than the new stops/angle gradients, so it also needs a value mapping.
  legacyBorderShim =
    state:
    {
      config,
      options,
      lib,
      ...
    }:
    let
      from = [
        "windows"
        "${state}-border"
      ];
      to = [
        "border"
        state
      ];
      fromOpt = lib.getAttrFromPath from options;
      old = lib.attrByPath from { } config;
      primary = old.gradient.primary or { };
      secondary = old.gradient.secondary or { };
      primaryColor = primary.color or null;
      primaryAngle = primary.angle or null;
      secondaryColor = secondary.color or null;
      secondaryAngle = secondary.angle or null;
      gradientFor =
        color: angle:
        if color == null && angle == null then
          null
        else
          {
            stops = optional (color != null) color;
            angle = angle;
          };
    in
    {
      options = lib.setAttrByPath from (mkOption {
        type = types.unspecified;
        visible = false;
        description = "Deprecated alias of `${lib.showOption to}`, with the old primary/secondary/lerp shape.";
      });
      config = mkIf fromOpt.isDefined (
        {
          _legacy = [
            "The option `programs.doors.settings.config.${lib.showOption from}` has been renamed to `programs.doors.settings.config.${lib.showOption to}` and changed shape: use `gradient.stops`/`gradient.angle`, `gradient2` and `gradient-lerp`."
          ];
        }
        // lib.setAttrByPath to (lib.mkDefault {
          color = old.color or null;
          gradient = gradientFor primaryColor primaryAngle;
          gradient2 = gradientFor secondaryColor secondaryAngle;
          gradient-lerp = old.gradient.lerp or null;
        })
      );
    };

  # `text` and `scroller` are generated groups whose new paths live in the
  # same group, so their shims belong inside those submodules.
  nestedImports = {
    text = [
      (legacyRename [ "text" ] [ "tab-color-text" ] [ "tab-color" "text" ])
      (legacyRename [ "text" ] [ "tab-color-text-active" ] [ "tab-color" "text-active" ])
      (legacyRename [ "text" ] [ "text-font" ] [ "font" ])
      (legacyRename [ "text" ] [ "text-height" ] [ "height" ])
    ];
    scroller = [
      (legacyRename [ "scroller" ] [ "scroller-default-proportion" ] [ "default-column-width" ])
      (legacyRename [ "scroller" ] [ "structs" "left" ] [ "struts" "left" ])
      (legacyRename [ "scroller" ] [ "structs" "right" ] [ "struts" "right" ])
      (legacyRename [ "scroller" ] [ "structs" "top" ] [ "struts" "top" ])
      (legacyRename [ "scroller" ] [ "structs" "bottom" ] [ "struts" "bottom" ])
    ];
  };

  # Everything else starts in a group that only the legacy tree defines
  # (windows/tabs/pointer/monocle/misc), so it is declared at this level.
  topLevelImports = [
    (legacyRename [ ] [ "windows" "border" ] [ "layout" "border-width" ])
    (legacyRename [ ] [ "windows" "gap" ] [ "layout" "window-gap" ])
    (legacyRename [ ] [ "windows" "smart-gaps" ] [ "layout" "smart-gaps" ])
    (legacyRename [ ] [ "windows" "smart-borders" ] [ "layout" "smart-borders" ])
    (legacyRename [ ] [ "windows" "focus-wrapping" ] [ "layout" "focus-wrapping" ])
    (legacyRename [ ] [ "windows" "focus-on-activate" ] [ "layout" "focus-on-activate" ])
    (legacyRename [ ] [ "windows" "decoration-mode" ] [ "layout" "decoration-mode" ])
    (legacyRename [ ] [ "windows" "borderless-singleton" ] [ "layout" "borderless-singleton" ])
    (legacyRename [ ] [ "windows" "monocle-padding" ] [ "layout" "monocle-padding" ])
    (legacyRename [ ] [ "windows" "respect-tiled-min-size" ] [ "layout" "respect-tiled-min-size" ])
    (legacyRename [ ] [ "windows" "presel-feedback-color" ] [ "border" "presel-feedback-color" ])
    (legacyRename [ ] [ "windows" "tiling-drag-indicator-color" ] [ "border" "tiling-drag-indicator-color" ])
    (legacyRename [ ] [ "pointer" "focus-follows-pointer" ] [ "layout" "focus-follows-pointer" ])
    (legacyRename [ ] [ "pointer" "pointer-follows-focus" ] [ "layout" "pointer-follows-focus" ])
    (legacyRename [ ] [ "tabs" "hide-lone-tab" ] [ "layout" "hide-lone-tab" ])
    (legacyRename [ ] [ "tabs" "color" "bar-background" ] [ "text" "tab-color" "bar-bg" ])
    (legacyRename [ ] [ "tabs" "color" "background" ] [ "text" "tab-color" "bg" ])
    (legacyRename [ ] [ "tabs" "color" "active-background" ] [ "text" "tab-color" "bg-active" ])
    (legacyRename [ ] [ "tabs" "color" "separator" ] [ "text" "tab-color" "sep" ])
    (legacyRename [ ] [ "monocole" "borderless-monocle" ] [ "layout" "borderless-monocle" ])
    (legacyRename [ ] [ "monocole" "gapless-monocle" ] [ "layout" "gapless-monocle" ])
    (legacyRename [ ] [ "misc" "allow-tearing" ] [ "layout" "allow-tearing" ])
    (legacyRename [ ] [ "misc" "auto-float-dialogs" ] [ "layout" "auto-float-dialogs" ])
    (legacyRename [ ] [ "misc" "enable-minimize" ] [ "layout" "enable-minimize" ])
    (legacyRename [ ] [ "misc" "enable-maximize" ] [ "layout" "enable-maximize" ])
    (legacyRename [ ] [ "misc" "minimize-to-scratchpad" ] [ "layout" "minimize-to-scratchpad" ])
    (legacyRename [ ] [ "misc" "record-history" ] [ "layout" "record-history" ])
    (legacyRename [ ] [ "misc" "ignore-ewmh-fullscreen" ] [ "layout" "ignore-ewmh-fullscreen" ])
    (legacyRename [ ] [ "misc" "split-ratio" ] [ "layout" "split-ratio" ])
    (legacyRename [ ] [ "misc" "automatic-scheme" ] [ "layout" "automatic-scheme" ])
    (legacyRename [ ] [ "misc" "initial-polarity" ] [ "layout" "initial-polarity" ])
    (legacyBorderShim "normal")
    (legacyBorderShim "active")
    (legacyBorderShim "focused")
  ];

in
{
  options.programs.doors = {
    enable = mkOption {
      type = types.bool;
      default = false;
      description = ''
        Whether to install Doors and generate its doorsrc/doorshkrc configuration files.
      '';
    };

    package = mkOption {
      type = types.package;
      default = self.packages.${pkgs.stdenv.hostPlatform.system}.doors;
      defaultText = literalExpression "self.packages.\${pkgs.stdenv.hostPlatform.system}.doors";
      description = ''
        The Doors package to use.
      '';
    };

    settings = mkOption {
      type = types.submodule {
        options = {
          outputs = mkOption {
            default = { };
            type = types.attrsOf (
              types.submodule {
                options = {
                  enable = mkOption {
                    type = types.nullOr types.bool;
                    default = null;
                    example = true;
                    description = "Whether to enable this display, applied via doorsctl output <name> enable";
                  };

                  mode = mkOption {
                    type = types.nullOr types.str;
                    default = null;
                    example = "1920x1080@60.0";
                    description = "Resolution/Mode for this output, applied via doorsctl output <name> mode.";
                  };

                  position = mkOption {
                    type = types.nullOr (
                      types.submodule {
                        options = {
                          x = mkOption {
                            type = types.int;
                            default = 0;
                            description = "X coordinate in pixels.";
                          };

                          y = mkOption {
                            type = types.int;
                            default = 0;
                            description = "Y coordinate in pixels.";
                          };
                        };
                      }
                    );
                    default = null;
                    example = {
                      x = 0;
                      y = 0;
                    };
                    description = "Output position in layout.";
                  };

                  scale = mkOption {
                    type = types.nullOr types.number;
                    default = null;
                    example = 1.5;
                    description = "Scale factor for this output, applied via doorsctl output <name> scale.";
                  };

                  transform = mkOption {
                    type = types.nullOr (
                      types.enum [
                        "normal"
                        "90"
                        "180"
                        "270"
                        "flipped"
                        "flipped-90"
                        "flipped-270"
                      ]
                    );
                    default = null;
                    example = "90";
                    description = "Specify a rotation for this output. Prefix degrees with `flipped` to mirror the display";
                  };

                  dpms = mkOption {
                    type = types.nullOr (
                      types.enum [
                        "on"
                        "off"
                      ]
                    );
                    default = null;
                    example = "on";
                    description = "Set the state of `dpms` for this output.";
                  };

                  adaptive-sync = mkOption {
                    type = types.nullOr (
                      types.enum [
                        "on"
                        "off"
                      ]
                    );
                    default = null;
                    example = "on";
                    description = "Set the state of 'adaptive_sync' for this output.";
                  };

                  render-bit-depth = mkOption {
                    type = types.nullOr (
                      types.enum [
                        "8"
                        "10"
                      ]
                    );
                    default = null;
                    example = "8";
                    description = "Set the `render_bit_depth` of this output.";
                  };

                  color-profile = mkOption {
                    type = types.nullOr (
                      types.enum [
                        "gamma22"
                        "srgb"
                      ]
                    );
                    default = null;
                    example = "gamma22";
                    description = "Set the 'color_profile' of this output.";
                  };

                  color-profile-icc = mkOption {
                    type = types.nullOr types.path;
                    default = null;
                    example = "/path/to/profile.icc";
                    description = "Set the 'color_profile icc' of this output from a file.";
                  };

                  hdr = mkOption {
                    type = types.nullOr (
                      types.enum [
                        "on"
                        "off"
                      ]
                    );
                    default = null;
                    example = "on";
                    description = "Set the 'hdr' state for this output. (requires Vulkan renderer, PQ/BT.2020 display support)";
                  };

                  tearing = mkOption {
                    type = types.nullOr (
                      types.enum [
                        "on"
                        "off"
                      ]
                    );
                    default = null;
                    example = "on";
                    description = "Whether to allow tearing on this output.";
                  };

                  max-render-time = mkOption {
                    type = types.nullOr types.str;
                    default = null;
                    example = "1";
                    description = "Set the max rendering time for this output, measured in ms. Can also be set to `off`";
                  };
                };
              }
            );
          };

          desktop = mkOption {
            type = types.submodule {
              options = {
                defaultLayout = mkOption {
                  type = types.nullOr (
                    types.enum [
                      "tiled"
                      "monocle"
                      "scroller"
                      "master_stack"
                    ]
                  );
                  default = null;
                  example = "tiled";
                  description = "Default layout mode to be applied to ALL desktops. Layout will reset to this on every session restart if value is set.";
                };

                workspaces = mkOption {
                  type = types.listOf types.str;
                  default = [
                    "I"
                    "II"
                    "III"
                  ];
                  description = "Names of the desktops applied to each output. The number of desktops is determined by the number of names provided. Applied to each output listed in `settings.outputs`, so it is ignored when none are configured.";
                };
              };
            };
            default = { };
            description = "Desktop setup applied by doors at startup: workspace names per output and an optional default layout for all desktops.";
          };

          config = mkOption {
            type = types.submodule {
              imports = topLevelImports;
              options = mkOptionTree upstream.entries nestedImports // {
                _legacy = legacyFlag;
              };
            };
            default = { };
            description = ''
              Settings applied via `doorsctl config`. Every key accepted by
              upstream `doorsctl config --list` has exactly one option here;
              unset (`null`) options are not emitted. See
              `modules/upstream-settings.nix` for the key-to-option mapping.
            '';
          };

          env = mkOption {
            type = types.attrsOf types.str;
            default = { };
            example = {
              XCURSOR_SIZE = "24";
              QT_QPA_PLATFORM = "wayland;xcb";
            };
            description = "Environment variables inherited by applications launched within 'Doors' (doorsctl env set).";
          };

          keybinds = mkOption {
            type = types.lines;
            default = "";
            description = "Keybinds to be passed to `doors/doorshkrc`. References for configuration can be found here: https://dawn.wine/CreeperFace/doors/src/branch/master/examples/doorshkrc";
          };

          extraConfig = mkOption {
            type = types.lines;
            default = "";
            description = "Extra configuration lines to be applied to the bottom of the configuration shell. Use this for commands that have no dedicated option (doorsctl input, rule, hotkey, bezier/spring registration, wm).";
          };
        };
      };
      default = { };
      description = ''
        Settings available for configuring the 'Doors' environment. Applied to 'doorsrc'
      '';
    };

    generated = mkOption {
      internal = true;
      readOnly = true;
      type = types.submodule {
        options = {
          doorsrc = mkOption {
            type = types.lines;
            default = "";
          };
          doorshkrc = mkOption {
            type = types.lines;
            default = "";
          };
        };
      };
    };
  };

  config = lib.mkMerge (
    [
      {
        programs.doors.generated.doorsrc = concatStringsSep "\n" (
          [ header ]
          ++ envLines
          ++ outputLines
          ++ outputSettingsLines
          ++ desktopLines
          ++ configLines
          ++ [ cfg.settings.extraConfig ]
        );

        programs.doors.generated.doorshkrc = concatStringsSep "\n" (
          [ header ] ++ [ cfg.settings.keybinds ]
        );
      }
    ]
    ++ [
      (lib.optionalAttrs (options ? assertions) {
        assertions = [
          {
            assertion =
              !cfg.enable
              || cfg.settings.config.shader.shader == null
              || cfg.settings.config.shader.file == null;
            message = "programs.doors.settings.config.shader: set either `shader` or `file`, not both.";
          }
          {
            assertion = !cfg.enable || cfg.settings.desktop.workspaces != [ ];
            message = "programs.doors.settings.desktop.workspaces must not be empty.";
          }
        ];
      })
      (lib.optionalAttrs (options ? warnings) {
        warnings = mkIf cfg.enable (
          map (
            c: "programs.doors.settings.config.animations: ${c.kind} curve \"${c.name}\" is not a builtin and was not found in `extraConfig`; register it with `doorsctl ${c.kind} ${c.name} ...`."
          ) unregisteredCurves
          ++ cfg.settings.config._legacy
        ++ cfg.settings.config.text._legacy
        ++ cfg.settings.config.scroller._legacy
        );
      })
    ]
  );
}
