#! /bin/sh

# Example doorsrc configuration
# This file is executed at server startup

# Set environment inherited by applications launched later from Doors hotkeys
# doorsctl env set XCURSOR_SIZE 24

# Set up desktops on HDMI-A-1 (names separated by spaces)
doorsctl output HDMI-A-1 -d I II III IV V VI VII VIII IX X

# Set border width
doorsctl config border_width 2

# Set window gap
doorsctl config window_gap 12

# Set borderless monocle
doorsctl config borderless_monocle true

# Set gapless monocle
doorsctl config gapless_monocle true

# Enable animations
doorsctl config enable_animations true

# Idle power management (DPMS timeout in seconds, 0 to disable)
doorsctl config idle_timeout 300
doorsctl config idle_dpms true

# Permission policy for unsandboxed clients (see README: Permission Commands).
# Rules are appended and the last matching rule wins.
# doorsctl permission 'exe:*grim' capture=allow
# doorsctl permission 'exe:*' capture=ask
